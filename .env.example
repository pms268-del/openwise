# ---- Core ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/siteiq   # Supabase: use the pooled connection string
SESSION_SECRET=change-me-to-a-long-random-string
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=change-me                       # Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/jobs/run

# ---- Supabase (optional; local password auth + local-disk storage are used when unset) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=                  # server-only; used for private evidence storage
SUPABASE_STORAGE_BUCKET=evidence

# ---- Google Maps Platform (optional; simulated competitors + approximate gazetteer when unset) ----
GOOGLE_MAPS_SERVER_KEY=                     # Geocoding API + Places API (New); restrict by IP/API
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=        # Maps JavaScript API; restrict by HTTP referrer

# ---- Public data (optional; simulated when disabled) ----
ENABLE_LIVE_CENSUS=false
CENSUS_API_KEY=
ENABLE_LIVE_NYC_OPEN_DATA=false
NYC_OPEN_DATA_APP_TOKEN=

# ---- Licensed listing partner feed (optional) ----
BROKER_FEED_URL=
BROKER_FEED_API_KEY=

# ---- Claude API (optional; deterministic templates / rule-based extraction when unset) ----
ANTHROPIC_API_KEY=
AI_MODEL_REASONING=claude-opus-5-5
AI_MODEL_EXTRACTION=claude-haiku-5-5

# ---- Stripe (optional; clearly-labeled simulated checkout when unset) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAID_RESEARCH_PRICE_CENTS=49900

# ---- AI voice calling: keep disabled until legal/compliance review. BOTH must be "true". ----
ENABLE_AI_VOICE_CALLS=false
AI_VOICE_COMPLIANCE_ATTESTED=false
